{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-config.js",
  "outputDirectory": ".",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/html/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/generate_b10_excel",
      "destination": "/api/generate_b10_excel.php"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/html/$1"
    }
  ]
}
